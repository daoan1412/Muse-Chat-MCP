{
  "name": "muse-chat-mcp",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "description": "MCP server + OpenAI-compatible HTTP shim that let any MCP or OpenAI client use Meta Muse (muse.ai, the \"Hatch\" agent) by driving your real, logged-in Chrome.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "muse",
    "meta",
    "hatch",
    "playwright",
    "openai",
    "openai-compatible",
    "llm",
    "browser-automation",
    "claude-desktop",
    "opencode"
  ],
  "license": "MIT",
  "author": "duclm1x1",
  "homepage": "https://github.com/duclm1x1/Muse-Chat-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duclm1x1/Muse-Chat-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/duclm1x1/Muse-Chat-MCP/issues"
  },
  "bin": {
    "muse-mcp": "muse-server.mjs",
    "muse": "muse-cli.mjs"
  },
  "scripts": {
    "start": "node muse-server.mjs",
    "muse": "node muse-cli.mjs",
    "selftest": "node muse-server.mjs --self-test",
    "dump": "node muse-server.mjs --dump-dom"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "omggif": "1.0.10",
    "playwright-core": "^1.63.0",
    "pngjs": "7.0.0",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  }
}
